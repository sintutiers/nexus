		{"id":"51f87aed9a8c551f","type":"text","text":"inventory interactions","x":342,"y":-920,"width":250,"height":60},
		{"id":"c7d8c8f22aa2e315","type":"text","text":"interact with items to pick them up","x":182,"y":-780,"width":250,"height":60},
